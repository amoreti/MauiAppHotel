<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Sobre"
             Title="Sobre"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Black}">

    <VerticalStackLayout VerticalOptions="CenterAndExpand"
                         Padding="10">
        <Label 
            Text="Sobre"
            VerticalOptions="Center" 
            HorizontalOptions="Center" 
            FontFamily="PTSerifBold"
            FontSize="40"
            TextColor="{StaticResource Magenta}" />

        <Border Padding="10">
            <VerticalStackLayout>

                <Label
                    Text="Me chamo Amanda Moreti, tenho 38 anos e sou estudante do curso Técnico de Desenvolvimento de Sistemas.&#10;Esse app foi desenvolvido em 31 de outubro de 2026 para a atividade da Agenda 13 do curso."
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    TextColor="{StaticResource Magenta}" /> 

             </VerticalStackLayout>
        </Border>

        <VerticalStackLayout Spacing="10">

            <Button Text="Voltar" 
                    HorizontalOptions="Center"
                    Margin="0,20,0,0"
                    Clicked="Button_Clicked" />

        </VerticalStackLayout>
        
    </VerticalStackLayout>

</ContentPage>