<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="Black">
    
    <VerticalStackLayout VerticalOptions="CenterAndExpand">

        <Label Text="{Binding QuartoSelecionado.Descricao}" 
               TextColor="Magenta"
               FontFamily="PTSerifRegular"
               FontSize="40"
               HorizontalTextAlignment="Center"/>

        <Border Margin="10">
            <StackLayout Orientation="Horizontal">
                <HorizontalStackLayout HorizontalOptions="CenterAndExpand">
                    <Label Text="Adultos: " 
                           TextColor="Magenta"/>
                    <Label Text="{Binding QntAdultos}" 
                           TextColor="Magenta" />                    
                </HorizontalStackLayout>

                <HorizontalStackLayout HorizontalOptions="CenterAndExpand">
                    <Label Text="Crianças: "
                           TextColor="Magenta"/>
                    <Label Text="{Binding QntCriancas}" 
                           TextColor="Magenta" />
                </HorizontalStackLayout>                
            </StackLayout>
        </Border>

        <Border Margin="10">
            <Grid ColumnDefinitions="*, *, *"
                  RowDefinitions="Auto, Auto">
                <Label Grid.Row="0" Grid.Column="0" Text="Check-in: " TextColor="Magenta" />
                <Label Grid.Row="0" Grid.Column="1" Text="Check-out: " TextColor="Magenta" />
                <Label Grid.Row="0" Grid.Column="2" Text="Estadia: " TextColor="Magenta" />

                <Label Grid.Row="1" Grid.Column="0" Text="{Binding DataCheckIn, StringFormat='{0:dd/MM/yyyy}'}" TextColor="Magenta" />
                <Label Grid.Row="1" Grid.Column="1" Text="{Binding DataCheckOut, StringFormat='{0:dd/MM/yyyy}'}" TextColor="Magenta" />
                <Label Grid.Row="1" Grid.Column="2" Text="{Binding Estadia}" TextColor="Magenta" />
            </Grid>
        </Border>

        <Border Margin="10">
            <HorizontalStackLayout HorizontalOptions="CenterAndExpand">
                <Label Text="Valor Total: R$" TextColor="Magenta" />
                <Label Text="{Binding ValorTotal, StringFormat='{}{0:c}'}" TextColor="Magenta"/>
            </HorizontalStackLayout>
        </Border>

        <Button Text="Voltar" 
                HorizontalOptions="Center"
                Clicked="Button_Clicked" />
    </VerticalStackLayout>
</ContentPage>