<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="Black">
    
    <VerticalStackLayout VerticalOptions="CenterAndExpand">

        <Label Text="Suíte Super Luxo" 
               TextColor="Magenta"
               FontFamily="PTSerifRegular"
               FontSize="40"
               HorizontalTextAlignment="Center"/>

        <Border Margin="10">
            <HorizontalStackLayout Spacing="50">
                <HorizontalStackLayout>
                    <Label Text="Adultos: " 
                           TextColor="Magenta"/>
                    <Label Text="2" 
                           TextColor="Magenta" />                    
                </HorizontalStackLayout>

                <HorizontalStackLayout>
                    <Label Text="Crianças: "
                           TextColor="Magenta"/>
                    <Label Text="1" 
                           TextColor="Magenta" />
                </HorizontalStackLayout>                
            </HorizontalStackLayout>
        </Border>

        <Border Margin="10">
            <Grid ColumnDefinitions="*, *, *"
                  RowDefinitions="Auto, Auto">
                <Label Grid.Row="0" Grid.Column="0" Text="Check-in: " TextColor="Magenta" />
                <Label Grid.Row="0" Grid.Column="1" Text="Check-out: " TextColor="Magenta" />
                <Label Grid.Row="0" Grid.Column="2" Text="Estadia: " TextColor="Magenta" />

                <Label Grid.Row="1" Grid.Column="0" Text="19/11/2026 " TextColor="Magenta" />
                <Label Grid.Row="1" Grid.Column="1" Text="22/11/2026 " TextColor="Magenta" />
                <Label Grid.Row="1" Grid.Column="2" Text="3" TextColor="Magenta" />
            </Grid>
        </Border>

        <Border Margin="10">
            <HorizontalStackLayout>
                <Label Text="Valor Total: " TextColor="Magenta" />
                <Label Text="R$750,00" TextColor="Magenta"/>
            </HorizontalStackLayout>
        </Border>

        <Button Text="Voltar" 
                HorizontalOptions="Center"
                Clicked="Button_Clicked" />
    </VerticalStackLayout>
</ContentPage>